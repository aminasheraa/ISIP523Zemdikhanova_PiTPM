<Page x:Class="ISIP523Zemdikhanova_PiTPM.Pages.Order"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP523Zemdikhanova_PiTPM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
            Background="LightBlue"
      Title="Order">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Оформление билета" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>


        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Height="330">
            <TextBlock x:Name="FilmText" FontSize="18" Margin="5" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="RoomText" FontSize="15" Margin="5" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DateText" FontSize="15" Margin="5" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TimeText" FontSize="15" Margin="5" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SeatText" FontSize="15" Margin="5" HorizontalAlignment="Center"/>
            <TextBlock x:Name="PriceText" FontSize="15" Margin="5" HorizontalAlignment="Center"/>
            <Button x:Name="ConfirmBtn" Content="Подтвердить покупку" FontSize="15" FontWeight="Bold" Width="180" Height="30" Click="ConfirmBtn_Click"/>

        </StackPanel>
    </Grid>

</Page>

