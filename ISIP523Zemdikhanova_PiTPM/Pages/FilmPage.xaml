<Page x:Class="ISIP523Zemdikhanova_PiTPM.Pages.FilmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP523Zemdikhanova_PiTPM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
            Background="LightBlue"
      Title="FilmPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.RowSpan="2" >
            <Image Height="200" Width="150" Source="{Binding Cover}" Margin="10"/>
            <TextBlock Text="{Binding FilmName}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding AgeRating.Name, StringFormat=Возрастной рейтинг: {0}}" FontSize="15" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Genre.GenreName, StringFormat=Жанры: {0}}" FontSize="15" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}" FontSize="15" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ShowStartDate, StringFormat=Дата выхода: {0:dd.MM.yyyy}}" FontSize="15" HorizontalAlignment="Center"/>
        </StackPanel>
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10">
            <TextBlock Text="{Binding Description}" FontSize="15" TextWrapping="Wrap" TextAlignment="Left" />
        </ScrollViewer>



        <TextBlock Grid.Column="1" Grid.Row="1" Text="Сеансы:" FontSize="22" FontWeight="Bold" Margin="10"/>
        <ListBox x:Name="SessionListBox" Grid.Column="1" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"  MouseDoubleClick="SessionListBox_MouseDoubleClick" Margin="10,50,30,15">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10">
                        <TextBlock Text="{Binding SessionDate, StringFormat=Дата: {0:dd.MM.yyyy}}" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SessionTime}" HorizontalAlignment="Center" Margin="0,4"/>
                        <TextBlock Text="{Binding Room.RoomName,StringFormat=Зал: {0}}" FontStyle="Italic" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="BackBtn" Grid.Row="1" Content="Назад" Width="180" Height="30" Margin="15" FontWeight="Bold" VerticalAlignment="Bottom" Click="BackBtn_Click"/>

    </Grid>
</Page>
