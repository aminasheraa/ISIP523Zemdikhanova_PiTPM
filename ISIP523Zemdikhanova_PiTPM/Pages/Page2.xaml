<Page x:Class="ISIP523Zemdikhanova_PiTPM.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP523Zemdikhanova_PiTPM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page2"  Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" x:Name="BackButton" Width="130"  Height="35" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Content="Назад" FontSize="16" FontWeight="Bold" Click="BackButton_Click"/>
        <Button Grid.Row="0" x:Name="ForwardButton" Width="130" Height="35" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Content="Далее" FontSize="16" FontWeight="Bold" Click="ForwardButton_Click"/>

    </Grid>
</Page>
