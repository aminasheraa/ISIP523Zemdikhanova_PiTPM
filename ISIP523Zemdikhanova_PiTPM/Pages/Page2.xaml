<Page x:Class="ISIP523Zemdikhanova_PiTPM.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP523Zemdikhanova_PiTPM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page2"  Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" x:Name="BackButton" ToolTip="Вернуться на предыдущую страницу" Width="130" Height="35" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Content="Назад" FontSize="16" FontWeight="Bold" Click="BackButton_Click"/>
        <TextBlock Text="№2. Подставьте свои значения в функцию: "  ToolTip="Задание №2" HorizontalAlignment="Center" Margin="25" FontSize="16" FontWeight="Bold" Width="360"/>
        <Button Grid.Row="0" x:Name="ForwardButton" ToolTip="Перейти на следующую страницу" Width="130" Height="35" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Content="Далее" FontSize="16" FontWeight="Bold" Click="ForwardButton_Click"/>

        <StackPanel Grid.Row="1">
            <Image Height="90" Width="350" Source= "\Images\Image2.png" VerticalAlignment="Top" ToolTip="Формула функции №2" Margin="10"/>

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">

                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="x :" FontSize="16" Margin="10" FontWeight="Bold"/>
                        <TextBox x:Name="XTextBox" Height="25" ToolTip="Введите число x (только цифры, точка и запятая)" Width="150" PreviewTextInput="TextBox_PreviewTextInput"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="b :" FontSize="16" Margin="10" FontWeight="Bold"/>
                        <TextBox x:Name="BTextBox" ToolTip="Введите число b (только цифры, точка и запятая)" Height="25" Width="150" PreviewTextInput="TextBox_PreviewTextInput"/>
                    </StackPanel>
                    <StackPanel Margin="10">
                        <TextBlock Text="Выбор функции f(x)" ToolTip="Выберите функцию, которую хотите вычислить" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <RadioButton x:Name="RadioButton1" ToolTip="Выберите гиперболический синус" Content="sh(x)" FontSize="16" HorizontalAlignment="Left"  />
                        <RadioButton x:Name="RadioButton2" ToolTip="Выберите функцию x²" Content="x^2" FontSize="16" HorizontalAlignment="Left" />
                        <RadioButton x:Name="RadioButton3" ToolTip="Выберите экспоненту e^x" Content="e^x" FontSize="16" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Oтвет: " FontWeight="Bold" HorizontalAlignment="Center" ToolTip="Здесь будет результат вычислений функции" FontSize="16" Margin="5" />
                        <TextBlock x:Name="AnswerTextBlock" Text=""  HorizontalAlignment="Center" FontSize="16" Margin="5" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel VerticalAlignment="Top">
                    <Button Content="Вычислить ответ " ToolTip="Нажмите для вычисления значения функции" Height="25" HorizontalAlignment="Center" FontSize="14" Width="140"  Margin="8" Click="Button_Click"/>
                    <Button x:Name="ClearButton" Content="Очистить " ToolTip="Очистить все поля ввода и результат" Height="25" HorizontalAlignment="Center" FontSize="14" Margin="8" Width="140" Click="ClearButton_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
