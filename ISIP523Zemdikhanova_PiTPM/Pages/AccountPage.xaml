<Page x:Class="ISIP523Zemdikhanova_PiTPM.Pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP523Zemdikhanova_PiTPM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
            Background="LightBlue"
      Title="AccountPage">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Grid.RowSpan="2" >
                <TextBlock Grid.Column="1" Text="Аккаунт" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Margin="10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Логин:" FontSize="15"  Margin="15, 5, 5, 5"/>
                    <TextBlock x:Name="UsernameText" FontSize="15" Margin="5" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Дата рождения: "  FontSize="15"  Margin="15, 5, 5, 5"/>
                    <TextBlock x:Name="DateOfBirthText" FontSize="15" Margin="5" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Почта:" FontSize="15"  Margin="15, 5, 5, 5"/>
                    <TextBlock x:Name="EmailText" FontSize="15" Margin="5" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <Button x:Name="BackBtn" Content="Назад" Width="180" Height="30" Margin="30" FontWeight="Bold" VerticalAlignment="Bottom" Click="BackBtn_Click"/>




            <TextBlock Grid.Column="1" Text="Билеты:" FontSize="22" FontWeight="Bold" Margin="10"/>
            <ListBox x:Name="TicketListBox" Grid.Column="1"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="10,50,30,30">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10">
                            <TextBlock Text="{Binding Session.Films.FilmName, StringFormat=Фильм: {0}}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Room.RoomID, StringFormat=Зал: {0}}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Seat.Number, StringFormat=Место: {0}}"  HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Session.SessionDate, StringFormat=Дата: {0:dd.MM.yyyy}}"  HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Session.SessionTime, StringFormat=Время: {0}}"  HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RoomCategory.Price, StringFormat=Цена: {0}}"  HorizontalAlignment="Center"/>
                        </StackPanel>




                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Page>
