<Page x:Class="ISIP523Zemdikhanova_PiTPM.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP523Zemdikhanova_PiTPM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
            Title="MainPage"
      Loaded="Page_Loaded"
      Background="LightBlue">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal"  HorizontalAlignment="Center">
            <TextBox x:Name="SearchBox" Margin="10" Width="150" Height="30" TextChanged="SearchBox_Changed"/>
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Сортировка:" HorizontalAlignment="Center"/>
                <RadioButton x:Name="SortByName" Content="По названию" Checked="Sort_Checked"/>
                <RadioButton x:Name="SortByRating" Content="По рейтингу" Checked="Sort_Checked"/>
            </StackPanel>
            <Button x:Name="RegButton" Content="Регистрация" Margin="10" Width="180" Height="30" FontWeight="Bold" Click="RegButton_Click" />
            <Button x:Name="AuthButton" Content="Вход" Margin="10" Width="180" Height="30" FontWeight="Bold" Click="AuthButton_Click" />
            <Button x:Name="LogOutButton" Content="Выход" Width="180" Height="30" Margin="10" FontWeight="Bold" Visibility="Collapsed" Click="LogOutButton_Click"/>
            <ComboBox Name="GenreComboBox" Width="100" Height="30" SelectedIndex="0" SelectionChanged="GenreComboBox_SelectionChanged">
                <ComboBoxItem Content="Боевик" />
                <ComboBoxItem Content="Комедия" />
                <ComboBoxItem Content="Ужасы" />
            </ComboBox>
            <Button x:Name="AccountButton" Content="Аккаунт" Width="180" Height="30" Margin="10" FontWeight="Bold" Visibility="Collapsed" Click="AccountButton_Click"/>



        </StackPanel>
        <ListBox x:Name="FilmListBox" Grid.Row="1"  Background="LightBlue" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" MouseDoubleClick="FilmListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Height="330" Width="200" Margin="8" >
                        <Image Height="200" Width="150" Source="{Binding Cover}"/>

                        <TextBlock HorizontalAlignment="Center" Text="Название:"/>
                        <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding FilmName}" />
                        <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding Rating, StringFormat=Рейтинг: {0}}" />
                        <TextBlock HorizontalAlignment="Center" Text="Дата начала показа:"/>
                        <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding ShowStartDate}" />
                        <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding AgeRating.Name, StringFormat=Возрастной рейтинг: {0}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

    </Grid>
</Page>
