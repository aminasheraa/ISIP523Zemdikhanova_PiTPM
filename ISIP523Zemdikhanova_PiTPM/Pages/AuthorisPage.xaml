<Page x:Class="ISIP523Zemdikhanova_PiTPM.Pages.AuthorisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP523Zemdikhanova_PiTPM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
            Title="AuthorisPage"
       Background="LightBlue">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Авторизация" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontWeight="Bold"/>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="296" Height="278">
            <TextBlock Text="Введите логин: " HorizontalAlignment="Center" FontSize="15"/>
            <TextBox x:Name="LoginTB" Margin="5"/>
            <TextBlock Text="Введите пароль (8 символов): " HorizontalAlignment="Center"  FontSize="15"/>
            <TextBox x:Name="PasswordTB" Margin="5"/>
            <Button x:Name="AuthBtn" Content="Войти" Margin="15" FontSize="15" FontWeight="Bold" Click="AuthBtn_Click"/>
            <Button x:Name="BackBtn" Content="Назад" Width="266" FontSize="15" Height="25" FontWeight="Bold" Click="BackBtn_Click"/>

        </StackPanel>
    </Grid>
</Page>
