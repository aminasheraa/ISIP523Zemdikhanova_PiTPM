<Page x:Class="ISIP523Zemdikhanova_PiTPM.Pages.SessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP523Zemdikhanova_PiTPM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
        Background="LightBlue"
  Title="SessionPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Места в зале: " FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="0" x:Name="HideTakenCheckBox" Content="Убрать все занятые места" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" Checked="HideTakenCheckBox_Checked" Unchecked="HideTakenCheckBox_Unchecked"/>
        <StackPanel  Grid.Row="1">
            <Border Width="500" Height="30" Background="White" CornerRadius="5" HorizontalAlignment="Center">
                <TextBlock Text="Экран" Foreground="Black" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ListBox x:Name="SeatListBox" Margin="10" Grid.Row="1"  Background="LightBlue" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="SeatListBox_MouseDoubleClick" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel  Margin="8" >
                            <TextBlock HorizontalAlignment="Center" Text="{Binding Seat.Number, StringFormat=Место: {0}}" />

                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>
        <Button x:Name="OrderBtn" Grid.Row="1" Content="Оформление билета" VerticalAlignment="Bottom" Margin="40" FontWeight="Bold" FontSize="15" Width="180" Height="30" Click="OrderBtn_Click"/>

    </Grid>
</Page>
