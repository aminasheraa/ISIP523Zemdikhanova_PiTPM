<Page x:Class="ISIP523Zemdikhanova_PiTPM.Pages.RegistratPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP523Zemdikhanova_PiTPM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
            Title="RegistratPage"
       Background="LightBlue">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Регистрация" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontWeight="Bold"/>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" >
            <TextBlock Text="Введите логин: " HorizontalAlignment="Center" FontSize="15"/>
            <TextBox x:Name="LoginTB" Margin="5"/>
            <TextBlock Text="Введите пароль (8 символов): " HorizontalAlignment="Center"  FontSize="15"/>
            <TextBox x:Name="PasswordTB" Margin="5"/>
            <TextBlock Text="Выберите дату рождения: " HorizontalAlignment="Center"  FontSize="15"/>
            <DatePicker x:Name="DateBirthDP" Margin="5"/>
            <TextBlock Text="Введите email: " HorizontalAlignment="Center"  FontSize="15"/>
            <TextBox x:Name="EmailTB" Margin="5"/>
            <Button x:Name="RegistBtn" Content="Зарегистрироваться" Margin="10" FontWeight="Bold" FontSize="15" Click="RegistBtn_Click"/>
            <Button x:Name="BackBtn" Content="Назад" Width="190" Height="25" FontWeight="Bold" FontSize="15" Click="BackBtn_Click"/>

        </StackPanel>
    </Grid>
</Page>
